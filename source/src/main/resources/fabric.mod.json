  "version": "${version}",
  "name": "TaskTussle",
  "description": "Server-side team bingo with block and advancement tasks.",
  "authors": ["WantToBeeMe"],
  "license": "All-Rights-Reserved",
  "environment": "server",
  "entrypoints": {
    "server": [
      { "value": "me.wanttobee.tasktussle.TaskTussleMod", "adapter": "kotlin" }
    ]
